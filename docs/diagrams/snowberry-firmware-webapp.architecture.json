  "cards": [
    {
      "dot": "emerald",
      "title": "Kontrol Lokal",
      "items": [
        "control::step memutuskan lebih dulu, cloud hanya lapisan monitoring",
        "WiFi/Firebase mati: threshold terakhir di NVS tetap dipakai",
        "Boot selalu menulis safe-state OFF sebelum pinMode"
      ]
    },
    {
      "dot": "cyan",
      "title": "Jalur Web App",
      "items": [
        "React/Vite membaca Firestore lewat realtime listener",
        "Batas Otomatis menulis config/thresholds",
        "Kontrol Manual mengirim commands lewat modal konfirmasi"
      ]
    },
    {
      "dot": "amber",
      "title": "Batas Kepercayaan",
      "items": [
        "firebase_sync non-blocking; kegagalan jaringan tidak menghentikan loop",
        "Pump AUTO OFF saat soil invalid atau belum dikalibrasi",
        "Hard-safety tetap menang atas manual override"
      ]
    }
  ]
