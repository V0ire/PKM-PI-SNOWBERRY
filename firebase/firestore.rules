rules_version = '2';
// Semua akses menuntut login (Firebase Auth).
// - Akun petani (web): baca semua data perangkat, tulis command/thresholds/profil.
// - Akun perangkat (ESP32): publish status/telemetry, baca config.
// Keduanya memakai email/password; pembatasan per-role via custom claims
// menyusul jika farm bertambah (lihat progress.md #12).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /devices/snowberry-001 {
      allow read: if signedIn();
      allow create, delete: if false;
      allow update: if signedIn();

      match /{document=**} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if false;
      }
    }
  }
}
