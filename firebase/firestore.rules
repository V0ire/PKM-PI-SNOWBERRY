rules_version = '2';
// TEMPORARY DEMO RULES. Replace with Anonymous Auth before production.
// Scope is deliberately limited to the one public demo device.
service cloud.firestore {
  match /databases/{database}/documents {
    match /devices/snowberry-001 {
      allow read, write: if true;

      match /{document=**} {
        allow read, write: if true;
      }
    }
  }
}
